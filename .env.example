# ============ 鲜智链 FreshChain 环境变量示例 ============
# 一键复现：cp .env.example .env，一般无需修改；如需自定义密码再填写。
# 留空时 docker compose 使用内置默认值（root / freshchain 密码 / freshchain 库）。
# 注意：不要把真实密码提交进仓库。

# MySQL 主机：本地手动跑填 localhost；Docker 内由 compose 注入为 mysql
MYSQL_HOST=mysql

# MySQL 端口
MYSQL_PORT=3306

# 数据库账号
MYSQL_USER=root

# MySQL 密码（占位留空，compose 默认 freshchain）
MYSQL_PASSWORD=

# 数据库名
MYSQL_DATABASE=freshchain
